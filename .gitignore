*.tsbuildinfo
/next-env.d.ts

# Logs
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# Local certificates and OS/editor files
*.pem
.DS_Store
Thumbs.db
*.swp
*.swo
